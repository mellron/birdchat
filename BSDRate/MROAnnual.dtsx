            <ScriptProject Name="ST_dbc_archive_rotate" VSTAMajorVersion="14" VSTAMinorVersion="0" Language="VisualBasic" ReadOnlyVariables="User::DBCurveFileExtension,User::DBCurveFileName,User::vBSDSendArchiveFolder">
              <ProjectItem Name="ScriptMain.vb" Encoding="UTF8"><![CDATA[' Microsoft SQL Server Integration Services Script Task
' Archive rotation for DBCurve file
Imports System
Imports System.IO
Imports Microsoft.SqlServer.Dts.Runtime

<Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute> _
<System.CLSCompliantAttribute(False)> _
Partial Public Class ScriptMain
    Inherits Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase

    Enum ScriptResults
        Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success
        Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
    End Enum

    Public Sub Main()
        Dim vBSDSendArchiveFolder As String = CStr(Dts.Variables("User::vBSDSendArchiveFolder").Value)
        Dim FileName As String = CStr(Dts.Variables("User::DBCurveFileName").Value)
        Dim FileExtension As String = CStr(Dts.Variables("User::DBCurveFileExtension").Value)
        Dim ArchiveFileCount As Integer = 4

        If File.Exists(vBSDSendArchiveFolder & FileName & "Prev" & ArchiveFileCount.ToString() & "." & FileExtension) Then
            File.Delete(vBSDSendArchiveFolder & FileName & "Prev" & ArchiveFileCount.ToString() & "." & FileExtension)
        End If

        For i As Integer = ArchiveFileCount - 1 To 1 Step -1
            If File.Exists(vBSDSendArchiveFolder & FileName & "Prev" & i.ToString() & "." & FileExtension) Then
                File.Move(vBSDSendArchiveFolder & FileName & "Prev" & i.ToString() & "." & FileExtension, _
                          vBSDSendArchiveFolder & FileName & "Prev" & (i + 1).ToString() & "." & FileExtension)
            End If
        Next

        If File.Exists(vBSDSendArchiveFolder & FileName & "." & FileExtension) Then
            File.Move(vBSDSendArchiveFolder & FileName & "." & FileExtension, _
                      vBSDSendArchiveFolder & FileName & "Prev1." & FileExtension)
        End If

        Dts.TaskResult = ScriptResults.Success
    End Sub
End Class]]></ProjectItem>
            </ScriptProject>
          </DTS:ObjectData>
