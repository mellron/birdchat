<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="My" GeneratedClassName="MySettings" UseMySettingsClassName="true">
  <Profiles />
  <Settings>
    <Setting Name="ConnectionString" Type="System.String" Scope="Application">
      <Value Profile="(Default)">DHWDesktop</Value>
    </Setting>
    <Setting Name="DHWDesktop" Type="System.String" Scope="Application">
      <Value Profile="(Default)"></Value>
    </Setting>
    <Setting Name="ScreenShots" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Prepayment4A,Prepayment4B,Prepayment4D,Prepayment4E,Prepayment4F,Prepayment4G,Prepayment4H,Prepayment4I,CalculatorsForm</Value>
    </Setting>
    <Setting Name="Environment" Type="System.String" Scope="Application">
      <Value Profile="(Default)">DevelopmentSettings</Value>
    </Setting>
    <Setting Name="UsersTable" Type="System.String" Scope="Application">
      <Value Profile="(Default)">tblUsers</Value>
    </Setting>
    <!-- TPP-0001 detolle - Environment-specific TreeView background colors (excluding Production) -->
    <Setting Name="DevEnvironmentColor" Type="System.String" Scope="Application">
      <Value Profile="(Default)">LightBlue</Value>
    </Setting>
    <Setting Name="ITEnvironmentColor" Type="System.String" Scope="Application">
      <Value Profile="(Default)">LightGreen</Value>
    </Setting>
    <Setting Name="UATEnvironmentColor" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Yellow</Value>
    </Setting>
    <Setting Name="ParallelEnvironmentColor" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Orange</Value>
    </Setting>
  </Settings>
</SettingsFile>