alStudio&gt;&lt;FlavorProperties GUID="{30D016F9-3734-4E33-A861-5E7D899E18F3}"&gt;&lt;ProjectProperties HostName="VSTAHostName" HostPackage="{B3A685AA-7EAF-4BC6-9940-57959FA5AC07}" ApplicationType="usd" Language="cs" TemplatesPath="" /&gt;&lt;Host Name="ScriptTask" /&gt;&lt;ProjectClient&gt;&lt;HostIdentifier&gt;SSIS_ST130&lt;/HostIdentifier&gt;&lt;/ProjectClient&gt;&lt;/FlavorProperties&gt;&lt;/VisualStudio&gt;&lt;/ProjectExtensions&gt;&lt;/Project&gt;</ProjectItem>
          
          
          <ProjectItem Name="WorkdayAuthentication.cs" Encoding="UTF8">using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Net.Security;
using System.Net;
using System.Security.Cryptography.X509Certificates;
using System.Text;

namespace Util
{
    public static class WorkdayAuthentication
    {
        private static string m_bearertoken = "";
        private static int m_expiresIn = 0;
        private static DateTime m_tokenIssuedAt = DateTime.MinValue;

        // Getter and setter for bearer token
        public static string BearerToken
        {
            get { return m_bearertoken; }
            set { m_bearertoken = value; }
        }

        // Getter and setter for expiresIn
        public static int ExpiresIn
        {
            get { return m_expiresIn; }
            set { m_expiresIn = value; }
        }

        /// &lt;summary&gt;
        /// Call this method when you receive a new token to set the issue time.
        /// &lt;/summary&gt;
        public static void SetTokenIssuedNow()
        {
            m_tokenIssuedAt = DateTime.UtcNow;
        }

        /// &lt;summary&gt;
        /// Returns true if the token has expired, false otherwise.
        /// Assumes m_expiresIn is in seconds (as is standard for OAuth2).
        /// &lt;/summary&gt;
        public static bool IsBearerTokenValid()
        {
            // Token must not be null or empty
            if (string.IsNullOrEmpty(m_bearertoken))
                return false; // No token

            if (m_tokenIssuedAt == DateTime.MinValue || m_expiresIn &lt;= 0)
                return false; // No token or invalid expiry

            // Add a small buffer (e.g., 30 seconds) to avoid edge cases
            var expiryTime = m_tokenIssuedAt.AddSeconds(m_expiresIn - 60);

            return DateTime.UtcNow &lt; expiryTime;
        }




        public static string GetBearerToken(string WebRequestURL, string certPath, string certPassphrase, string ConsumerKey, string ConsumerSecret)
        {

            if (IsBearerTokenValid())
            {
                return BearerToken;
            }

            WebRequest request = SetupWebRequest(WebRequestURL, certPath, certPassphrase, ConsumerKey, ConsumerSecret);

            // lets write out the bearer token
            string results = "";

            using (HttpWebResponse response = (HttpWebResponse)request.GetResponse())
            {
                using (StreamReader reader = new StreamReader(response.GetResponseStream()))
                {
                    results = reader.ReadToEnd();
                }
            }

            // Retrieve the access token and check for null or empty
            string accessToken = Utility.GetJsonValueManual(results, "accessToken");

            if (string.IsNullOrEmpty(accessToken))
            {
                throw new Exception("Failed to retrieve a valid bearer token from the response.");
            }

            BearerToken = accessToken;

            // Retrieve expiresIn and check for valid integer
            string expiresInValue = Utility.GetJsonValueManual(results, "expiresIn");
            if (!int.TryParse(expiresInValue, out int expiresIn))
            {
                throw new Exception("Failed to retrieve a valid expiration time from the response.");
            }

            ExpiresIn = expiresIn;

            SetTokenIssuedNow();

            return BearerToken;

        }

        /// &lt;summary&gt;
        /// This is a C# script that sets up a web request with basic authentication.
        /// It will also load workday.crt and workday.key
        /// using cert passphrase: ISU_API_User
        /// It is used in SSIS Packages
        /// &lt;/summary&gt;
        ///
        /// &lt;param name="WebRequestURL"&gt;The web request url&lt;/param&gt;
        ///
        /// &lt;returns&gt;The web request.&lt;/returns&gt;

        private static WebRequest SetupWebRequest(string WebRequestURL, string certPath, string certPassphrase, string ConsumerKey, string ConsumerSecret)
        {
            try
            {
                ServicePointManager.Expect100Continue = true;

                // Remove insecure protocols (SSL3, TLS 1.0, TLS 1.1)
                ServicePointManager.SecurityProtocol &amp;= ~SecurityProtocolType.Ssl3;
                ServicePointManager.SecurityProtocol &amp;= ~SecurityProtocolType.Tls;
                ServicePointManager.SecurityProtocol &amp;= ~SecurityProtocolType.Tls11;

                // Add TLS 1.2
                ServicePointManager.SecurityProtocol |= SecurityProtocolType.Tls12;

                ServicePointManager.ServerCertificateValidationCallback = delegate (Object obj, X509Certificate certificate, X509Chain chain, SslPolicyErrors errors)
                {
                    return true;
                };



                // Load the certificate using the GetCertificate method
                X509Certificate2 cert = Utility.GetCertificate(certPath, certPassphrase);

                // Create the web request
                HttpWebRequest Request = (HttpWebRequest)WebRequest.Create(WebRequestURL);

                // Attach the certificate to the request
                Request.ClientCertificates.Add(cert);

                // Combine ConsumerKey and ConsumerSecret for Basic authentication
                string credentials = $"{ConsumerKey}:{ConsumerSecret}";
                byte[] plainTextBytes = Encoding.UTF8.GetBytes(credentials);

                // Encode credentials in Base64
                string val = Convert.ToBase64String(plainTextBytes);

                Request.Headers.Add("Authorization", "Basic " + val);

                Request.Method = "POST";

                // I need to add grant_type value of client_credentials to the body
                Request.ContentType = "application/x-www-form-urlencoded";

                Request.ContentLength = 0;

                string postData = "grant_type=client_credentials";

                byte[] byteArray = Encoding.UTF8.GetBytes(postData);

                Request.ContentLength = byteArray.Length;

                using (Stream dataStream = Request.GetRequestStream())
                {
                    dataStream.Write(byteArray, 0, byteArray.Length);
                }


                return Request;
            }
            catch (Exception ex)
            {
                throw new Exception("Error setting up web request: " + ex.Message, ex);
            }
        }

        /// &lt;summary&gt;
        /// Gets the certificate.
        /// &lt;/summary&gt;
        ///
        /// &lt;param name="certPath"&gt;The cert path&lt;/param&gt;
        /// &lt;param name="certPassphrase"&gt;The cert passphrase&lt;/param&gt;
        ///
        /// &lt;returns&gt;The certificate.&lt;/returns&gt;

    }
}</ProjectItem>
          
          
          <ProjectItem Name="ImportAccountingJournalService.cs" Encoding="UTF8">// ImportAccountingJournal.cs
// .NET Framework 4.5 helper for posting a Workday "Import Accounting Journal" request through Apigee
using System;
using System.Collections.Generic;
using System.IO;
using System.Net;
using System.Net.Security;
using System.Security.Cryptography.X509Certificates;
using System.Text;
using System.Xml.Linq;

namespace Util
{
    /// &lt;summary&gt;
    /// Builds the XML payload for Workday Import Accounting Journal and posts it to the Apigee endpoint.
    /// &lt;/summary&gt;
    public static class ImportAccountingJournalService
    {
        /// &lt;summary&gt;
        /// Sends an Import Accounting Journal request to the specified Apigee URL.
        /// &lt;/summary&gt;
        /// &lt;param name="url"&gt;The import‑accounting‑journal endpoint.&lt;/param&gt;
        /// &lt;param name="payload"&gt;Strong‑typed request body; default values are pre‑seeded.&lt;/param&gt;
        /// &lt;param name="bearerToken"&gt;OAuth2 access token from WorkdayAuthentication.GetBearerToken.&lt;/param&gt;
        /// &lt;param name="certPath"&gt;Optional path to a client certificate (pfx).&lt;/param&gt;
        /// &lt;param name="certPassphrase"&gt;Passphrase for the client certificate.&lt;/param&gt;
        /// &lt;returns&gt;The raw XML response from Apigee / Workday.&lt;/returns&gt;
        public static string Import(string url, string xml, string bearerToken,
                                    string certPath = null, string certPassphrase = null)
        {
            // TLS &amp; optional client certificate setup – mirrors WorkdayAuthentication
            ServicePointManager.Expect100Continue = true;
            ServicePointManager.SecurityProtocol &amp;= ~SecurityProtocolType.Ssl3;
            ServicePointManager.SecurityProtocol &amp;= ~SecurityProtocolType.Tls;
            ServicePointManager.SecurityProtocol &amp;= ~SecurityProtocolType.Tls11;
            ServicePointManager.SecurityProtocol |= SecurityProtocolType.Tls12;

            ServicePointManager.ServerCertificateValidationCallback = delegate (Object obj, X509Certificate certificate, X509Chain chain, SslPolicyErrors errors)
            {
                return true;  
            };

            // Load the certificate using the GetCertificate method
            X509Certificate2 cert = Utility.GetCertificate(certPath, certPassphrase);

            HttpWebRequest Request = (HttpWebRequest)WebRequest.Create(url);

            // Attach the certificate to the request
            Request.ClientCertificates.Add(cert);

            Request.Method = "POST";
            Request.ContentType = "text/xml; charset=utf-8";
            Request.Headers.Add("Authorization", "Bearer " + bearerToken);
           
            byte[] bytes = Encoding.UTF8.GetBytes(xml);
            Request.ContentLength = bytes.Length;

            using (Stream s = Request.GetRequestStream())
            {
                s.Write(bytes, 0, bytes.Length);
            }

            using (var response = (HttpWebResponse)Request.GetResponse())

            using (var reader = new StreamReader(response.GetResponseStream()))
            {
                return reader.ReadToEnd();
            }
        }
    }

    /// &lt;summary&gt;
    /// Strongly‑typed representation of the Import_Accounting_Journal_Request SOAP payload.
    /// Only the commonly‑used nodes are exposed as properties; extend as needed.
    /// &lt;/summary&gt;
    public class ImportAccountingJournalPayload
    {
        // --- Attributes on Import_Accounting_Journal_Request ---
        public bool AddOnly { get; set; }
        public bool CreateJournalWithErrors { get; set; }
        public string Version { get; set; }

        // --- Business_Process_Parameters ---
        public bool AutoComplete { get; set; }
        public string Comment { get; set; }

        // --- Accounting_Journal_Data (header) ---
        public bool Submit { get; set; }
        public string CompanyId { get; set; }
        public string CurrencyId { get; set; }
        public string LedgerTypeId { get; set; }
        public DateTime AccountingDate { get; set; }
        public string JournalSourceId { get; set; }
        public string JournalMemo { get; set; }

        public const string VERSION = "v40.2";
        public const string COMMENT = "Treasury posting interface";
        public const string COMPANY_ID = "225";
        public const string CURRENCY_ID = "USD";
        public const string LEDGER_TYPE_ID = "Actuals";
        public const string JOURNAL_SOURCE_ID = "Manual_Journal";
        public const string JOURNAL_MEMO = "ApiGee Workday GL Update";



        // --- Lines ---
        public List&lt;JournalEntryLine&gt; Lines { get; private set; } = new List&lt;JournalEntryLine&gt;();

        /// &lt;summary&gt;
        /// Initializes the payload with default process parameters and header data.
        /// Use AddJournalEntryLine() or AddJournalEntryLines() to append journal lines.
        /// &lt;/summary&gt;
        public ImportAccountingJournalPayload()
        {
            // Mirroring the Postman collection
            CreateJournalWithErrors = false;
            Version = VERSION;
            AutoComplete = true;
            Comment = COMMENT;
            Submit = true;
            CompanyId = COMPANY_ID;
            CurrencyId = CURRENCY_ID;
            LedgerTypeId = LEDGER_TYPE_ID;
            AccountingDate = DateTime.Today;
            JournalSourceId = JOURNAL_SOURCE_ID;
            JournalMemo = JOURNAL_MEMO;

            // Lines collection is empty by default; use AddJournalEntryLine() or AddJournalEntryLines() to add entries
        }

        /// &lt;summary&gt;
        /// Adds a single journal entry line to the payload.
        /// &lt;/summary&gt;
        /// &lt;param name="line"&gt;The journal entry line data to include.&lt;/param&gt;
        /// &lt;example&gt;
        /// var payload = new ImportAccountingJournalPayload();
        /// payload.AddJournalEntryLine(new JournalEntryLine
        /// {
        ///     CompanyId      = "225",
        ///     LedgerAccountId= "1650350",
        ///     Debit          = 100m,
        ///     Credit         = 0m,
        ///     CurrencyId     = "USD",
        ///     Memo           = "line 1",
        ///     Worktags       = new List&lt;Worktag&gt;
        ///     {
        ///         new Worktag { Type = "Cost_Center_Reference_ID", Id = "02250002443" },
        ///         new Worktag { Type = "Project_ID",               Id = "AFE43193" }
        ///     }
        /// });
        /// &lt;/example&gt;
        public void AddJournalEntryLine(JournalEntryLine line)
        {
            if (line == null) throw new ArgumentNullException(nameof(line));
            Lines.Add(line);
        }

        /// &lt;summary&gt;
        /// Adds multiple journal entry lines to the payload.
        /// Loops through the provided array and calls AddJournalEntryLine for each.
        /// &lt;/summary&gt;
        /// &lt;param name="lines"&gt;Array of journal entry line data to include.&lt;/param&gt;
        public void AddJournalEntryLines(JournalEntryLine[] lines)
        {
            ClearJournalEntryLines();

            if (lines == null) throw new ArgumentNullException(nameof(lines));
            foreach (var line in lines)
            {
                AddJournalEntryLine(line);
            }
        }
        /// &lt;summary&gt;
        ///  Clears the Lines collection.
        /// &lt;/summary&gt;
        public void ClearJournalEntryLines()
        {
            Lines.Clear();
        }

        /// &lt;summary&gt;
        /// Converts this object graph into a raw Workday SOAP XML envelope.
        /// &lt;/summary&gt;
        /// &lt;returns&gt;XML string representing the Import_Accounting_Journal SOAP request.&lt;/returns&gt;
        public string ToXml()
        {
            XNamespace env = "http://schemas.xmlsoap.org/soap/envelope/";
            XNamespace wd = "urn:com.workday/bsvc";

            var envelope = new XElement(env + "Envelope",
                new XAttribute(XNamespace.Xmlns + "env", env),
                new XAttribute(XNamespace.Xmlns + "wd", wd),
                new XElement(env + "Body",
                    new XElement(wd + "Import_Accounting_Journal_Request",
                        new XAttribute(wd + "Add_Only", AddOnly.ToString().ToLowerInvariant()),
                        new XAttribute(wd + "Create_Journal_with_Errors", CreateJournalWithErrors.ToString().ToLowerInvariant()),
                        new XAttribute(wd + "version", Version),
                        new XElement(wd + "Business_Process_Parameters",
                            new XElement(wd + "Auto_Complete", AutoComplete.ToString().ToLowerInvariant()),
                            new XElement(wd + "Comment_Data",
                                new XElement(wd + "Comment", Comment)
                            )
                        ),
                        BuildAccountingJournalData(wd)
                    )
                )
            );

            var doc = new XDocument(new XDeclaration("1.0", "utf-8", "yes"), envelope);
            return doc.ToString(SaveOptions.DisableFormatting);
        }

        /// &lt;summary&gt;
        /// Constructs the Accounting_Journal_Data element, including header fields and all journal entry lines.
        /// &lt;/summary&gt;
        /// &lt;param name="wd"&gt;The Workday XML namespace.&lt;/param&gt;
        /// &lt;returns&gt;XElement representing the Accounting_Journal_Data node.&lt;/returns&gt;
        private XElement BuildAccountingJournalData(XNamespace wd)
        {
            var data = new XElement(wd + "Accounting_Journal_Data",
                new XElement(wd + "Submit", Submit.ToString().ToLowerInvariant()),
                new XElement(wd + "Company_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Company_Reference_ID"),
                        CompanyId)),
                new XElement(wd + "Currency_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Currency_ID"),
                        CurrencyId)),
                new XElement(wd + "Ledger_Type_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Ledger_Type_ID"),
                        LedgerTypeId)),
                new XElement(wd + "Accounting_Date", AccountingDate.ToString("yyyy-MM-dd")),
                new XElement(wd + "Journal_Source_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Journal_Source_ID"),
                        JournalSourceId)),
                new XElement(wd + "Journal_Entry_Memo", JournalMemo)
            );

            foreach (var line in Lines)
            {
                data.Add(line.ToXElement(wd));
            }

            return data;
        }
    }

    /// &lt;summary&gt;
    /// Represents a single journal entry line within an accounting journal.
    /// &lt;/summary&gt;
    public class JournalEntryLine
    {
        /// &lt;summary&gt;The company reference ID for this line.&lt;/summary&gt;
        public string CompanyId { get; set; }
        /// &lt;summary&gt;The ledger account reference ID for this line.&lt;/summary&gt;
        public string LedgerAccountId { get; set; }
        /// &lt;summary&gt;The debit amount for this line.&lt;/summary&gt;
        public decimal Debit { get; set; }
        /// &lt;summary&gt;The credit amount for this line.&lt;/summary&gt;
        public decimal Credit { get; set; }
        /// &lt;summary&gt;The currency reference ID for this line.&lt;/summary&gt;
        public string CurrencyId { get; set; }
        /// &lt;summary&gt;Memo or description for this line.&lt;/summary&gt;
        public string Memo { get; set; }
        /// &lt;summary&gt;List of Worktags associated with this line.&lt;/summary&gt;
        public List&lt;Worktag&gt; Worktags { get; set; } = new List&lt;Worktag&gt;();

        /// &lt;summary&gt;
        /// Converts this JournalEntryLine into its XML representation for the SOAP payload.
        /// &lt;/summary&gt;
        /// &lt;param name="wd"&gt;The Workday XML namespace.&lt;/param&gt;
        /// &lt;returns&gt;XElement representing the Journal_Entry_Line_Replacement_Data node.&lt;/returns&gt;
        internal XElement ToXElement(XNamespace wd)
        {
            var elem = new XElement(wd + "Journal_Entry_Line_Replacement_Data",
                new XElement(wd + "Line_Company_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Company_Reference_ID"),
                        CompanyId)),
                new XElement(wd + "Ledger_Account_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Ledger_Account_ID"),
                        new XAttribute(wd + "parent_id", "USBC"),
                        new XAttribute(wd + "parent_type", "Account_Set_ID"),
                        LedgerAccountId)),
                new XElement(wd + "Debit_Amount", Debit.ToString("0.##")),
                new XElement(wd + "Credit_Amount", Credit.ToString("0.##")),
                new XElement(wd + "Currency_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Currency_ID"),
                        CurrencyId)),
                new XElement(wd + "Memo", Memo)
            );

            foreach (var wt in Worktags)
            {
                elem.Add(new XElement(wd + "Worktags_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", wt.Type),
                        wt.Id)));
            }

            return elem;
        }
    }

    /// &lt;summary&gt;
    /// Represents a Worktag reference (e.g., cost center, project) for journal lines.
    /// &lt;/summary&gt;
    public class Worktag
    {
        /// &lt;summary&gt;
        /// The Workday identifier type for this worktag (e.g., "Cost_Center_Reference_ID").
        /// &lt;/summary&gt;
        public string Type { get; set; }

        /// &lt;summary&gt;
        /// The specific ID value for this worktag.
        /// &lt;/summary&gt;
        public string Id { get; set; }
    }
}</ProjectItem>
          
          
          <ProjectItem Name="Utility.cs" Encoding="UTF8">using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Security.Cryptography.X509Certificates;
using System.Text;
using System.Threading.Tasks;
using System.Xml.Linq;


namespace Util
{

    public static class Utility
    {
        /// &lt;summary&gt;
        /// Gets the JSON value manually from a JSON string.
        /// &lt;/summary&gt;
        /// &lt;param name="json"&gt;The JSON string.&lt;/param&gt;
        /// &lt;param name="key"&gt;The key to search for.&lt;/param&gt;
        /// &lt;returns&gt;The value associated with the key, or null if not found.&lt;/returns&gt;
        ///
        ///
        public static string GetJsonValueManual(string json, string key)
        {
            if (string.IsNullOrEmpty(json) || string.IsNullOrEmpty(key))
                return null;

            // 1. Find the property name
            string quotedKey = "\"" + key + "\"";
            int keyPos = json.IndexOf(quotedKey, StringComparison.OrdinalIgnoreCase);
            if (keyPos &lt; 0) return null;

            // 2. Find the ':' after the key
            int colonPos = json.IndexOf(':', keyPos + quotedKey.Length);
            if (colonPos &lt; 0) return null;

            // 3. Skip whitespace to start of value
            int i = colonPos + 1;
            while (i &lt; json.Length &amp;&amp; char.IsWhiteSpace(json[i])) i++;
            if (i &gt;= json.Length) return null;

            // 4a. If it’s a quoted string
            if (json[i] == '\"')
            {
                int start = i + 1;
                int end = start;
                // find closing quote (simple; doesn’t handle escaped quotes)
                while (end &lt; json.Length &amp;&amp; json[end] != '\"') end++;
                if (end &gt;= json.Length) return null;
                return json.Substring(start, end - start);
            }
            // 4b. Otherwise read until comma, brace or whitespace
            else
            {
                int start = i;
                int end = i;
                while (end &lt; json.Length
                       &amp;&amp; json[end] != ','
                       &amp;&amp; json[end] != '}'
                       &amp;&amp; !char.IsWhiteSpace(json[end]))
                {
                    end++;
                }
                return json.Substring(start, end - start);
            }
        }
        /// &lt;summary&gt;
        /// Pulls WID value from Workday Import process post call response. 
        /// &lt;/summary&gt;
        /// &lt;param name="xml"&gt;&lt;/param&gt;
        /// &lt;returns&gt;&lt;/returns&gt;
        public static string GetImportProcessWid(string xml)
        {
            XNamespace wd = "urn:com.workday/bsvc";

            return XDocument.Parse(xml)
                            .Descendants(wd + "ID")
                            .First(e =&gt; (string)e.Attribute(wd + "type") == "WID")
                            .Value;          // e.g. 96e9df6547ae1001b89e6c5a555c0000
        }


        /// &lt;summary&gt;
        /// Gets the certificate from a pfx file
        /// &lt;/summary&gt;
        ///
        /// &lt;param name="certPath"&gt;The cert path&lt;/param&gt;
        /// &lt;param name="certPassphrase"&gt;The cert passphrase&lt;/param&gt;
        ///
        /// &lt;returns&gt;The certificate.&lt;/returns&gt;
        public static X509Certificate2 GetCertificate(string certPath, string certPassphrase)
        {
            try
            {
                // raise an exception if cert does not exists at certPath
                if (!File.Exists(certPath))
                {
                    throw new FileNotFoundException("Certificate file not found.", certPath);
                }

                // check if cert in pfx format has expired or not
                X509Certificate2 cert = new X509Certificate2(certPath, certPassphrase);

                if (cert.NotAfter &lt; DateTime.Now)
                {
                    throw new InvalidOperationException("Certificate has expired.");
                }

                // Load the certificate from the specified path with the passphrase
                return cert;
            }
            catch (Exception ex)
            {
                throw new InvalidOperationException("Failed to load the certificate.", ex);
            }
        }

        /// &lt;summary&gt;
        /// Gets the certificate from a pfx string
        /// &lt;/summary&gt;
        ///
        /// &lt;param name="certPath"&gt;The cert path&lt;/param&gt;
        /// &lt;param name="certPassphrase"&gt;The cert passphrase&lt;/param&gt;
        ///
        /// &lt;returns&gt;The certificate.&lt;/returns
        public static X509Certificate2 GetPfxCertificateFromBase64(string base64Pfx, string certPassphrase)
        {
            try
            {
                // Convert the Base64 string to a byte array
                byte[] certBytes = Convert.FromBase64String(base64Pfx);

                // Load the certificate with appropriate flags
                X509Certificate2 cert = new X509Certificate2(
                    certBytes,
                    certPassphrase,
                    X509KeyStorageFlags.MachineKeySet | X509KeyStorageFlags.PersistKeySet
                );

                // Check if the certificate is expired
                if (cert.NotAfter &lt; DateTime.Now)
                {
                    throw new InvalidOperationException("Certificate has expired.");
                }

                return cert;
            }
            catch (Exception ex)
            {
                throw new InvalidOperationException("Failed to load the PFX certificate from Base64 string.", ex);
            }
        }

    

    /// &lt;summary&gt;
    ///  Gets the certificate from a root and itnermediate crt files. 
    /// &lt;/summary&gt;
    /// &lt;param name="rootCertPath"&gt;&lt;/param&gt;
    /// &lt;param name="intermediateCertPath"&gt;&lt;/param&gt;
    /// &lt;returns&gt;&lt;/returns&gt;
    /// &lt;exception cref="InvalidOperationException"&gt;&lt;/exception&gt;
    public static X509Certificate2Collection GetCertificateCRT(string rootCertPath, string intermediateCertPath)
        {
            try
            {
                if (!File.Exists(rootCertPath))
                    throw new FileNotFoundException("Root certificate file not found.", rootCertPath);

                if (!File.Exists(intermediateCertPath))
                    throw new FileNotFoundException("Intermediate certificate file not found.", intermediateCertPath);

                var rootCert = new X509Certificate2(rootCertPath);
                var intermediateCert = new X509Certificate2(intermediateCertPath);

                var certCollection = new X509Certificate2Collection
                {
                  rootCert,
                  intermediateCert
                };

                return certCollection;
            }
            catch (Exception ex)
            {
                throw new InvalidOperationException("Failed to load one or more certificates.", ex);
            }
        }



        public static X509Certificate2 GetCertificateFromStore(string subjectName)
        {
            X509Store store = new X509Store(StoreName.My, StoreLocation.LocalMachine);

            try
            {
                store.Open(OpenFlags.ReadOnly | OpenFlags.OpenExistingOnly);

                // Find by subject common name (CN)
                var matches = store.Certificates
                                   .Find(X509FindType.FindBySubjectName,
                                         subjectName,
                                         validOnly: false);

                if (matches.Count == 0)
                    throw new InvalidOperationException(
                        $"Certificate '{subjectName}' not found in LocalMachine/My.");

                // If there are multiple, pick the one with the latest NotBefore date
                var cert = matches
                    .OfType&lt;X509Certificate2&gt;()
                    .OrderByDescending(c =&gt; c.NotBefore)
                    .First();

                // Optional: check expiration
                if (DateTime.Now &lt; cert.NotBefore || DateTime.Now &gt; cert.NotAfter)
                    throw new InvalidOperationException(
                        $"Certificate '{subjectName}' is not valid at this time.");

                return cert;
            }
            finally
            {
                store.Close();
            }
        }

        /// &lt;summary&gt;
        /// Returns the number of days until the certificate expires.
        /// Can return negative values if the certificate is already expired.
        /// &lt;/summary&gt;
        /// &lt;param name="certPath"&gt;The path to the certificate file.&lt;/param&gt;
        /// &lt;param name="certPassphrase"&gt;The passphrase for the certificate.&lt;/param&gt;
        /// &lt;returns&gt;Number of days until expiration (can be negative).&lt;/returns&gt;
        /// &lt;exception cref="Exception"&gt;Thrown if the certificate cannot be loaded.&lt;/exception&gt;
        public static int GetDaysUntilCertificateExpires(string certPath, string certPassphrase)
        {
            if (string.IsNullOrEmpty(certPath))
                throw new ArgumentException("Certificate path cannot be null or empty.");

            if (!File.Exists(certPath))
                throw new FileNotFoundException("Certificate file not found.", certPath);

            try
            {
                var certificate = new X509Certificate2(certPath, certPassphrase, X509KeyStorageFlags.MachineKeySet);
                TimeSpan timeUntilExpiry = certificate.NotAfter - DateTime.UtcNow;
                return (int)Math.Floor(timeUntilExpiry.TotalDays);
            }
            catch (Exception ex)
            {
                throw new Exception("Failed to load certificate: " + ex.Message, ex);
            }
        }


    }
}</ProjectItem>
          
          
          <ProjectItem Name="ScriptMain.cs" Encoding="UTF8">#region Help:  Introduction to the script task
/* The Script Task allows you to perform virtually any operation that can be accomplished in
 * a .Net application within the context of an Integration Services control flow. 
 * 
 * Expand the other regions which have "Help" prefixes for examples of specific ways to use
 * Integration Services features within this script task. */
#endregion


#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using Util;
using System.Collections.Generic;


#endregion

namespace ST_cdff0c6534194b0f86c82fe86f10386b
{
    /// &lt;summary&gt;
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// &lt;/summary&gt;
	[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
	public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
	{
        #region Help:  Using Integration Services variables and parameters in a script
        /* To use a variable in this script, first ensure that the variable has been added to 
         * either the list contained in the ReadOnlyVariables property or the list contained in 
         * the ReadWriteVariables property of this script task, according to whether or not your
         * code needs to write to the variable.  To add the variable, save this script, close this instance of
         * Visual Studio, and update the ReadOnlyVariables and 
         * ReadWriteVariables properties in the Script Transformation Editor window.
         * To use a parameter in this script, follow the same steps. Parameters are always read-only.
         * 
         * Example of reading from a variable:
         *  DateTime startTime = (DateTime) Dts.Variables["System::StartTime"].Value;
         * 
         * Example of writing to a variable:
         *  Dts.Variables["User::myStringVariable"].Value = "new value";
         * 
         * Example of reading from a package parameter:
         *  int batchId = (int) Dts.Variables["$Package::batchId"].Value;
         *  
         * Example of reading from a project parameter:
         *  int batchId = (int) Dts.Variables["$Project::batchId"].Value;
         * 
         * Example of reading from a sensitive project parameter:
         *  int batchId = (int) Dts.Variables["$Project::batchId"].GetSensitiveValue();
         * */

        #endregion

        #region Help:  Firing Integration Services events from a script
        /* This script task can fire events for logging purposes.
         * 
         * Example of firing an error event:
         *  Dts.Events.FireError(18, "Process Values", "Bad value", "", 0);
         * 
         * Example of firing an information event:
         *  Dts.Events.FireInformation(3, "Process Values", "Processing has started", "", 0, ref fireAgain)
         * 
         * Example of firing a warning event:
         *  Dts.Events.FireWarning(14, "Process Values", "No values received for input", "", 0);
         * */
        #endregion

        #region Help:  Using Integration Services connection managers in a script
        /* Some types of connection managers can be used in this script task.  See the topic 
         * "Working with Connection Managers Programatically" for details.
         * 
         * Example of using an ADO.Net connection manager:
         *  object rawConnection = Dts.Connections["Sales DB"].AcquireConnection(Dts.Transaction);
         *  SqlConnection myADONETConnection = (SqlConnection)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Sales DB"].ReleaseConnection(rawConnection);
         *
         * Example of using a File connection manager
         *  object rawConnection = Dts.Connections["Prices.zip"].AcquireConnection(Dts.Transaction);
         *  string filePath = (string)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Prices.zip"].ReleaseConnection(rawConnection);
         * */
        #endregion

        // Public variables to hold the DTS variables
       
        public static string WorkdayCert;
        public static string WorkdayCertPassphrase;
        public static string NotificationMessage;


        /// &lt;summary&gt;
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// &lt;/summary&gt;

        public void Main()
        {

            try
            {

                WorkdayCert = Dts.Variables["User::WorkdayCert"].Value.ToString();
                WorkdayCertPassphrase = Dts.Variables["User::WorkdayCertPassphrase"].Value.ToString();
                NotificationMessage = "";



                // Validate that none of the variables are empty or null
                if (
                       string.IsNullOrWhiteSpace(WorkdayCert) ||
                       string.IsNullOrWhiteSpace(WorkdayCertPassphrase)
                  )
                {
                    Dts.TaskResult = (int)ScriptResults.Failure;
                    return;
                }


                try
                {
                    int DaysLeft = Utility.GetDaysUntilCertificateExpires(WorkdayCert, WorkdayCertPassphrase);

                    Dts.Variables["User::iDaysCertExpire"].Value = DaysLeft;

                    if (DaysLeft &lt; 20)
                    {
                        NotificationMessage = $"Workday certificate will expire in less than 1 day. Days left: {DaysLeft}";

                        Dts.Variables["User::NotificationMessage"].Value = NotificationMessage;

                  
                    }

                    if (DaysLeft &lt; 1)
                    {
            

                        NotificationMessage = $"Workday certificate has expired or is invalid. Please check the certificate.";

                        Dts.Variables["User::NotificationMessage"].Value = NotificationMessage;

                        Dts.TaskResult = (int)ScriptResults.Failure;

                        return;
                    }
                }
                catch (Exception ex)
                {
                    Dts.TaskResult = (int)ScriptResults.Failure;
                    return;
                }


                // TODO: Add your code here

                Dts.TaskResult = (int)ScriptResults.Success;


            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Script Task", $"Error: {ex.Message}", "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }



        #region ScriptResults declaration
        /// &lt;summary&gt;
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// &lt;/summary&gt;
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion

	}
}</ProjectItem>
          
          
