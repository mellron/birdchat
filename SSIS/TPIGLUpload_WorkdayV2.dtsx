         * 
         * Example of firing an information event:
         *  Dts.Events.FireInformation(3, "Process Values", "Processing has started", "", 0, ref fireAgain)
         * 
         * Example of firing a warning event:
         *  Dts.Events.FireWarning(14, "Process Values", "No values received for input", "", 0);
         * */
        #endregion

        #region Help:  Using Integration Services connection managers in a script
        /* Some types of connection managers can be used in this script task.  See the topic 
         * "Working with Connection Managers Programatically" for details.
         * 
         * Example of using an ADO.Net connection manager:
         *  object rawConnection = Dts.Connections["Sales DB"].AcquireConnection(Dts.Transaction);
         *  SqlConnection myADONETConnection = (SqlConnection)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Sales DB"].ReleaseConnection(rawConnection);
         *
         * Example of using a File connection manager
         *  object rawConnection = Dts.Connections["Prices.zip"].AcquireConnection(Dts.Transaction);
         *  string filePath = (string)rawConnection;
         *  //Use the connection in some code here, then release the connection
         *  Dts.Connections["Prices.zip"].ReleaseConnection(rawConnection);
         * */
        #endregion

        // Public variables to hold the DTS variables
        public static string WorkdayAuthURL;
        public static string WorkdayCert;
        public static string WorkdayCertPassphrase;
        public static string WorkdayImportURL;
        public static string WorkdayStatusURL;
        public static string WorkdayWID;
        public static string ConsumerKey;
        public static string ConsumerSecret;
        public static string xmlPayload;
        public static string notificationMessage;

        const string CURRENCY = "USD";

        // This will be used to build the XML for the REST API call body
        public ImportAccountingJournalPayload payload { get; set; } = new ImportAccountingJournalPayload();


        /// &lt;summary&gt;
        /// This method is called when this script task executes in the control flow.
        /// Before returning from this method, set the value of Dts.TaskResult to indicate success or failure.
        /// To open Help, press F1.
        /// &lt;/summary&gt;

        public void Main()
        {
            string Bearertoken;
            string WID;
            ImportProcessStatus status;


            try
            {
                WorkdayAuthURL = Dts.Variables["User::WorkdayAuthURL"].Value.ToString();
                WorkdayCert = Dts.Variables["User::WorkdayCert"].Value.ToString();
                WorkdayCertPassphrase = Dts.Variables["User::WorkdayCertPassphrase"].Value.ToString();
                WorkdayImportURL = Dts.Variables["User::WorkdayImportURL"].Value.ToString();
                WorkdayStatusURL = Dts.Variables["User::WorkdayStatusURL"].Value.ToString();
                ConsumerKey = Dts.Variables["User::ConsumerKey"].Value.ToString();
                ConsumerSecret = Dts.Variables["User::ConsumerSecret"].Value.ToString();
                xmlPayload = Dts.Variables["User::WorkdayXMLPayload"].Value.ToString();
                notificationMessage = Dts.Variables["User::NotificationMessage"].Value.ToString();


                // Validate that none of the variables are empty or null
                if (string.IsNullOrWhiteSpace(WorkdayAuthURL) ||
                     string.IsNullOrWhiteSpace(WorkdayCert) ||
                     string.IsNullOrWhiteSpace(WorkdayCertPassphrase) ||
                     string.IsNullOrWhiteSpace(WorkdayImportURL) ||
                     string.IsNullOrWhiteSpace(WorkdayStatusURL) ||
                     string.IsNullOrWhiteSpace(xmlPayload) 
                     )
                {
                    Dts.TaskResult = (int)ScriptResults.Failure;
                    return;
                }


                try
                {
                    Bearertoken = Util.WorkdayAuthentication.GetBearerToken(WorkdayAuthURL, WorkdayCert, WorkdayCertPassphrase, ConsumerKey, ConsumerSecret);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error getting bearer token: {ex.Message}");
                    Dts.TaskResult = (int)ScriptResults.Failure;
                    return;
                }


                try
                {
                    //Post to Apigee / Workday
                    string xmlResponse = ImportAccountingJournalService.Import(WorkdayImportURL,
                                                                               xmlPayload,
                                                                               Bearertoken,
                                                                               WorkdayCert, WorkdayCertPassphrase);

                    // extract WID. This is used for the next step to validate that import was successful
                    WID = Utility.GetImportProcessWid(xmlResponse);

                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error calling Workday Import accounting Journal : {ex.Message}");
                    Dts.TaskResult = (int)ScriptResults.Failure;
                    return;
                }


                try
                {
                    // check the status of the call.
                    status = ImportProcessStatusService.GetStatus(WorkdayStatusURL, WID, Bearertoken, WorkdayCert, WorkdayCertPassphrase);


                    //check percent completed . Percent is 0 - 1
                    while (Utility.GetImportProcessPercent_Complete(status.RawXml) != "1")
                    {
                        // lets pause for a miniute and try again 
                        System.Threading.Thread.Sleep(60000); 
                        status = ImportProcessStatusService.GetStatus(WorkdayStatusURL, WID, Bearertoken, WorkdayCert, WorkdayCertPassphrase);

                    }

                    Dts.Variables["User::NotificationMessage"].Value = status.RawXml;
                }
                catch (Exception ex)
                {

                    Dts.Variables["User::NotificationMessage"].Value = ImportProcessStatusService.responseXML;

                    Console.WriteLine($"Error calling Workday status : {ex.Message}");

                    Dts.TaskResult = (int)ScriptResults.Failure;

                    return;
                }

                Dts.TaskResult = (int)ScriptResults.Success;


            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Script Task", $"Error: {ex.Message}", "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }


        #region ScriptResults declaration
            /// &lt;summary&gt;
            /// This enum provides a convenient shorthand within the scope of this class for setting the
            /// result of the script.
            /// 
            /// This code was generated automatically.
            /// &lt;/summary&gt;
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion

	}
}</ProjectItem>
          
          
          <ProjectItem Name="ImportProcessStatusService.cs" Encoding="UTF8">using System;
using System.IO;
using System.Linq;
using System.Net;
using System.Net.Security;
using System.Security.Cryptography.X509Certificates;
using System.Text;
using System.Xml.Linq;
using Util;

namespace Util
{
    /// &lt;summary&gt;
    /// Lightweight client for the /get-status endpoint (Import Accounting Journal) that returns XML.
    /// &lt;/summary&gt;
    public static class ImportProcessStatusService
    {
        public static string responseXML = "";

        /// &lt;summary&gt;
        /// Calls the get-status URL, passing the Import Process WID, and returns a parsed &lt;see cref="ImportProcessStatus"/&gt;.
        /// &lt;/summary&gt;
        /// &lt;param name="url"&gt;e.g. https://dev-api2.us.bank-dns.com/third-party/workday/postgl/v1/get-status&lt;/param&gt;
        /// &lt;param name="wid"&gt;ImportProcessResponse.ImportProcessWid&lt;/param&gt;
        /// &lt;param name="bearerToken"&gt;OAuth2 token from WorkdayAuthentication&lt;/param&gt;
        /// &lt;param name="certPath"&gt;Optional PFX certificate path&lt;/param&gt;
        /// &lt;param name="certPassphrase"&gt;Certificate password&lt;/param&gt;
        public static ImportProcessStatus GetStatus(string url, string wid, string bearerToken,
                                                   string certPath, string certPassphrase)
        {
            if (string.IsNullOrWhiteSpace(wid)) throw new ArgumentNullException(nameof(wid));

            // TLS / client-cert boilerplate (mirrors other helpers)
            ServicePointManager.Expect100Continue = true;
            ServicePointManager.SecurityProtocol &amp;= ~SecurityProtocolType.Ssl3
                                                   &amp; ~SecurityProtocolType.Tls
                                                   &amp; ~SecurityProtocolType.Tls11;

            ServicePointManager.SecurityProtocol |= SecurityProtocolType.Tls12;

            ServicePointManager.ServerCertificateValidationCallback = (obj, cert, chain, errors) =&gt; true;    // relax for dev

            // Load the certificate using the GetCertificate method
            X509Certificate2 _cert = Utility.GetCertificate(certPath, certPassphrase);

            HttpWebRequest Request = (HttpWebRequest)WebRequest.Create(url);

            // Attach the certificate to the request
            Request.ClientCertificates.Add(_cert);

            Request.Method = "POST";
            Request.ContentType = "application/x-www-form-urlencoded";
            Request.Headers.Add("Authorization", "Bearer " + bearerToken);

            string form = "import_process_reference_id=" + Uri.EscapeDataString(wid);

            byte[] body = Encoding.UTF8.GetBytes(form);
            Request.ContentLength = body.Length;

            using (var s = Request.GetRequestStream()) s.Write(body, 0, body.Length);

            using (var resp = (HttpWebResponse)Request.GetResponse())
            using (var r = new StreamReader(resp.GetResponseStream()))
            {
                string xml = r.ReadToEnd();
                responseXML = xml;
                return ImportProcessStatus.Parse(xml);
            }
        }
    }

    /// &lt;summary&gt;
    /// POCO for the status XML returned by Workday.  Extend as needed.
    /// &lt;/summary&gt;
    public class ImportProcessStatus
    {
        public string State { get; private set; }   // Completed, In_Progress, Failed, etc.
        public int PercentComplete { get; private set; }
        public DateTime? CompletedDateTime { get; private set; }
        public bool HasMessages { get; private set; }

        /// &lt;summary&gt;The raw XML returned by the endpoint (for logging).&lt;/summary&gt;
        public string RawXml { get; private set; }

        private ImportProcessStatus() { }

        /// &lt;summary&gt;
        /// Parses the XML returned by Workday into a strongly typed object.
        /// &lt;/summary&gt;
        internal static ImportProcessStatus Parse(string xml)
        {
            if (string.IsNullOrWhiteSpace(xml))
                throw new ArgumentNullException(nameof(xml));

            XNamespace wd = "urn:com.workday/bsvc";

            var doc = XDocument.Parse(xml);

            var data = doc.Descendants(wd + "Import_Process_Data").FirstOrDefault();
            if (data == null)
                throw new InvalidOperationException("Import_Process_Data element not found in response.");

            string status = data
                .Element(wd + "Status_Reference")?
                .Elements(wd + "ID")
                .FirstOrDefault(e =&gt; (string)e.Attribute(wd + "type") == "Background_Process_Instance_Status_ID")?
                .Value;

            int percent = int.TryParse(data.Element(wd + "Percent_Complete")?.Value, out int p) ? p : 0;

            DateTime? completedDt = DateTime.TryParse(data.Element(wd + "Process_Completed_DateTime")?.Value,
                                                      out DateTime dt) ? dt : (DateTime?)null;

            bool hasMsgs = data.Element(wd + "Has_Messages")?.Value == "1";

            return new ImportProcessStatus
            {
                RawXml = xml,
                State = status,
                PercentComplete = percent,
                CompletedDateTime = completedDt,
                HasMessages = hasMsgs
            };
        }

        public bool IsTerminal =&gt; State == "Completed" || State == "Failed";

        public override string ToString()
            =&gt; $"{State} ({PercentComplete}%)" +
               (CompletedDateTime.HasValue ? $" – Done {CompletedDateTime:yyyy-MM-dd HH:mm:ss}" : string.Empty);
    }
}</ProjectItem>
          
          
