                    <arrayElement dataType="System.String">using System;
using System.Collections.Generic;
using System.IO;
using System.Net;
using System.Net.Security;
using System.Security.Cryptography.X509Certificates;
using System.Text;
using System.Xml.Linq;

namespace Util
{
    /// &lt;summary&gt;
    /// Builds the XML payload for Workday Import Accounting Journal and posts it to the Apigee endpoint.
    /// &lt;/summary&gt;
    public static class ImportAccountingJournalService
    {
        /// &lt;summary&gt;
        /// Sends an Import Accounting Journal request to the specified Apigee URL.
        /// &lt;/summary&gt;
        /// &lt;param name="url"&gt;The import‑accounting‑journal endpoint.&lt;/param&gt;
        /// &lt;param name="payload"&gt;Strong‑typed request body; default values are pre‑seeded.&lt;/param&gt;
        /// &lt;param name="bearerToken"&gt;OAuth2 access token from WorkdayAuthentication.GetBearerToken.&lt;/param&gt;
        /// &lt;param name="certPath"&gt;Optional path to a client certificate (pfx).&lt;/param&gt;
        /// &lt;param name="certPassphrase"&gt;Passphrase for the client certificate.&lt;/param&gt;
        /// &lt;returns&gt;The raw XML response from Apigee / Workday.&lt;/returns&gt;
        public static string Import(string url, ImportAccountingJournalPayload payload, string bearerToken,
                                    string certPath = null, string certPassphrase = null)
        {
            // TLS &amp; optional client certificate setup – mirrors WorkdayAuthentication
            ServicePointManager.Expect100Continue = true;
            ServicePointManager.SecurityProtocol &amp;= ~SecurityProtocolType.Ssl3;
            ServicePointManager.SecurityProtocol &amp;= ~SecurityProtocolType.Tls;
            ServicePointManager.SecurityProtocol &amp;= ~SecurityProtocolType.Tls11;
            ServicePointManager.SecurityProtocol |= SecurityProtocolType.Tls12;

            ServicePointManager.ServerCertificateValidationCallback = delegate (Object obj, X509Certificate certificate, X509Chain chain, SslPolicyErrors errors)
            {
                return true; // trust all – replace with real validation in production
            };

            // Load the certificate using the GetCertificate method
            X509Certificate2 cert = Utility.GetCertificate(certPath, certPassphrase);

            HttpWebRequest Request = (HttpWebRequest)WebRequest.Create(url);

            // Attach the certificate to the request
            Request.ClientCertificates.Add(cert);

            Request.Method = "POST";
            Request.ContentType = "text/xml; charset=utf-8";
            Request.Headers.Add("Authorization", "Bearer " + bearerToken);

            string xml = payload.ToXml();
            byte[] bytes = Encoding.UTF8.GetBytes(xml);
            Request.ContentLength = bytes.Length;

            using (Stream s = Request.GetRequestStream())
            {
                s.Write(bytes, 0, bytes.Length);
            }

            using (var response = (HttpWebResponse)Request.GetResponse())
            using (var reader = new StreamReader(response.GetResponseStream()))
            {
                return reader.ReadToEnd();
            }
        }
    }

    /// &lt;summary&gt;
    /// Strongly‑typed representation of the Import_Accounting_Journal_Request SOAP payload.
    /// Only the commonly‑used nodes are exposed as properties; extend as needed.
    /// &lt;/summary&gt;
    public class ImportAccountingJournalPayload
    {
        // --- Attributes on Import_Accounting_Journal_Request ---
        public bool AddOnly { get; set; }
        public bool CreateJournalWithErrors { get; set; }
        public string Version { get; set; }

        // --- Business_Process_Parameters ---
        public bool AutoComplete { get; set; }
        public string Comment { get; set; }

        // --- Accounting_Journal_Data (header) ---
        public bool Submit { get; set; }
        public string CompanyId { get; set; }
        public string CurrencyId { get; set; }
        public string LedgerTypeId { get; set; }
        public DateTime AccountingDate { get; set; }
        public string JournalSourceId { get; set; }
        public string JournalMemo { get; set; }

        public const string VERSION = "v40.2";
        public const string COMMENT = "Treasury posting interface";
        public const string COMPANY_TAG = "%%COMPANY_TAG%%";
        public const string CURRENCY_ID = "USD";
        public const string LEDGER_TYPE_ID = "Actuals";
        public const string JOURNAL_SOURCE_ID = "Manual_Journal";
        public const string JOURNAL_MEMO = "ApiGee Workday GL Update";

        // --- Lines ---
        public List&lt;JournalEntryLine&gt; Lines { get; private set; } = new List&lt;JournalEntryLine&gt;();

        /// &lt;summary&gt;
        /// Initializes the payload with default process parameters and header data.
        /// Use AddJournalEntryLine() or AddJournalEntryLines() to append journal lines.
        /// &lt;/summary&gt;
        public ImportAccountingJournalPayload()
        {
            // Mirroring the Postman collection
            CreateJournalWithErrors = false;
            Version = VERSION;
            AutoComplete = true;
            Comment = COMMENT;
            Submit = true;
            CompanyId = COMPANY_TAG;
            CurrencyId = CURRENCY_ID;
            LedgerTypeId = LEDGER_TYPE_ID;
            AccountingDate = DateTime.Today;
            JournalSourceId = JOURNAL_SOURCE_ID;
            JournalMemo = JOURNAL_MEMO;

            // Lines collection is empty by default; use AddJournalEntryLine() or AddJournalEntryLines() to add entries
        }


        /// &lt;summary&gt;
        /// Adds a single journal entry line to the payload.
        /// &lt;/summary&gt;
        /// &lt;param name="line"&gt;The journal entry line data to include.&lt;/param&gt;
        /// &lt;example&gt;
        /// var payload = new ImportAccountingJournalPayload();
        /// payload.AddJournalEntryLine(new JournalEntryLine
        /// {
        ///     CompanyId      = "225",
        ///     LedgerAccountId= "1650350",
        ///     Debit          = 100m,
        ///     Credit         = 0m,
        ///     CurrencyId     = "USD",
        ///     Memo           = "line 1",
        ///     Worktags       = new List&lt;Worktag&gt;
        ///     {
        ///         new Worktag { Type = "Cost_Center_Reference_ID", Id = "02250002443" },
        ///         new Worktag { Type = "Project_ID",               Id = "AFE43193" }
        ///     }
        /// });
        /// &lt;/example&gt;
        public void AddJournalEntryLine(JournalEntryLine line)
        {
            if (line == null) throw new ArgumentNullException(nameof(line));
            Lines.Add(line);
        }

        /// &lt;summary&gt;
        /// Adds multiple journal entry lines to the payload.
        /// Loops through the provided array and calls AddJournalEntryLine for each.
        /// &lt;/summary&gt;
        /// &lt;param name="lines"&gt;Array of journal entry line data to include.&lt;/param&gt;
        public void AddJournalEntryLines(JournalEntryLine[] lines)
        {
            ClearJournalEntryLines();

            if (lines == null) throw new ArgumentNullException(nameof(lines));
            foreach (var line in lines)
            {
                AddJournalEntryLine(line);
            }
        }
        /// &lt;summary&gt;
        ///  Clears the Lines collection.
        /// &lt;/summary&gt;
        public void ClearJournalEntryLines()
        {
            Lines.Clear();
        }

        /// &lt;summary&gt;
        /// Converts this object graph into a raw Workday SOAP XML envelope.
        /// &lt;/summary&gt;
        /// &lt;returns&gt;XML string representing the Import_Accounting_Journal SOAP request.&lt;/returns&gt;
        public string ToXml()
        {
            XNamespace env = "http://schemas.xmlsoap.org/soap/envelope/";
            XNamespace wd = "urn:com.workday/bsvc";

            var envelope = new XElement(env + "Envelope",
                new XAttribute(XNamespace.Xmlns + "env", env),
                new XAttribute(XNamespace.Xmlns + "wd", wd),
                new XElement(env + "Body",
                    new XElement(wd + "Import_Accounting_Journal_Request",
                        new XAttribute(wd + "Add_Only", AddOnly.ToString().ToLowerInvariant()),
                        new XAttribute(wd + "Create_Journal_with_Errors", CreateJournalWithErrors.ToString().ToLowerInvariant()),
                        new XAttribute(wd + "version", Version),
                        new XElement(wd + "Business_Process_Parameters",
                            new XElement(wd + "Auto_Complete", AutoComplete.ToString().ToLowerInvariant()),
                            new XElement(wd + "Comment_Data",
                                new XElement(wd + "Comment", Comment)
                            )
                        ),
                        BuildAccountingJournalData(wd)
                    )
                )
            );

            var doc = new XDocument(new XDeclaration("1.0", "utf-8", "yes"), envelope);

            string returnxml = doc.ToString(SaveOptions.DisableFormatting);

            // What we are doing here is setting the company id in the header of the xml payload
            // We will just use the first bank/company number in a detail line.

            returnxml = Utility.ReplaceCompanyNumberInHeader(returnxml, COMPANY_TAG, Lines[0].CompanyId);
            
            return returnxml;
        }

        /// &lt;summary&gt;
        /// Constructs the Accounting_Journal_Data element, including header fields and all journal entry lines.
        /// &lt;/summary&gt;
        /// &lt;param name="wd"&gt;The Workday XML namespace.&lt;/param&gt;
        /// &lt;returns&gt;XElement representing the Accounting_Journal_Data node.&lt;/returns&gt;
        private XElement BuildAccountingJournalData(XNamespace wd)
        {
            var data = new XElement(wd + "Accounting_Journal_Data",
                new XElement(wd + "Submit", Submit.ToString().ToLowerInvariant()),
                new XElement(wd + "Company_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Company_Reference_ID"),
                        CompanyId)),
                new XElement(wd + "Currency_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Currency_ID"),
                        CurrencyId)),
                new XElement(wd + "Ledger_Type_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Ledger_Type_ID"),
                        LedgerTypeId)),
                new XElement(wd + "Accounting_Date", AccountingDate.ToString("yyyy-MM-dd")),
                new XElement(wd + "Journal_Source_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Journal_Source_ID"),
                        JournalSourceId)),
                new XElement(wd + "Journal_Entry_Memo", JournalMemo)
            );

            foreach (var line in Lines)
            {
                data.Add(line.ToXElement(wd));
            }

            return data;
        }
    }

    /// &lt;summary&gt;
    /// Represents a single journal entry line within an accounting journal.
    /// &lt;/summary&gt;
    public class JournalEntryLine
    {
        /// &lt;summary&gt;The company reference ID for this line.&lt;/summary&gt;
        public string CompanyId { get; set; }
        /// &lt;summary&gt;The ledger account reference ID for this line.&lt;/summary&gt;
        public string LedgerAccountId { get; set; }
        /// &lt;summary&gt;The debit amount for this line.&lt;/summary&gt;
        public decimal Debit { get; set; }
        /// &lt;summary&gt;The credit amount for this line.&lt;/summary&gt;
        public decimal Credit { get; set; }
        /// &lt;summary&gt;The currency reference ID for this line.&lt;/summary&gt;
        public string CurrencyId { get; set; }
        /// &lt;summary&gt;Memo or description for this line.&lt;/summary&gt;
        public string Memo { get; set; }
        /// &lt;summary&gt;List of Worktags associated with this line.&lt;/summary&gt;
        public List&lt;Worktag&gt; Worktags { get; set; } = new List&lt;Worktag&gt;();

        /// &lt;summary&gt;
        /// Converts this JournalEntryLine into its XML representation for the SOAP payload.
        /// &lt;/summary&gt;
        /// &lt;param name="wd"&gt;The Workday XML namespace.&lt;/param&gt;
        /// &lt;returns&gt;XElement representing the Journal_Entry_Line_Replacement_Data node.&lt;/returns&gt;
        internal XElement ToXElement(XNamespace wd)
        {
            var elem = new XElement(wd + "Journal_Entry_Line_Replacement_Data",
                new XElement(wd + "Line_Company_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Company_Reference_ID"),
                        CompanyId)),
                new XElement(wd + "Ledger_Account_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Ledger_Account_ID"),
                        new XAttribute(wd + "parent_id", "USBC"),
                        new XAttribute(wd + "parent_type", "Account_Set_ID"),
                        LedgerAccountId)),
                new XElement(wd + "Debit_Amount", Debit.ToString("0.##")),
                new XElement(wd + "Credit_Amount", Credit.ToString("0.##")),
                new XElement(wd + "Currency_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", "Currency_ID"),
                        CurrencyId)),
                new XElement(wd + "Memo", Memo)
            );

            foreach (var wt in Worktags)
            {
                elem.Add(new XElement(wd + "Worktags_Reference",
                    new XElement(wd + "ID",
                        new XAttribute(wd + "type", wt.Type),
                        wt.Id)));
            }

            return elem;
        }
    }

    /// &lt;summary&gt;
    /// Represents a Worktag reference (e.g., cost center, project) for journal lines.
    /// &lt;/summary&gt;
    public class Worktag
    {
        /// &lt;summary&gt;
        /// The Workday identifier type for this worktag (e.g., "Cost_Center_Reference_ID").
        /// &lt;/summary&gt;
        public string Type { get; set; }

        /// &lt;summary&gt;
        /// The specific ID value for this worktag.
        /// &lt;/summary&gt;
        public string Id { get; set; }
    }
}
</arrayElement>
                    
                    
                    <arrayElement dataType="System.String">Utility.cs</arrayElement>
                    
                    
